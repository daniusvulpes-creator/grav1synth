
name: Build Grav1synth for Windows

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: windows-latest

    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      - name: Install Rust
        uses: dtolnay/rust-toolchain@stable

      - name: Build release
        run: cargo build --locked --release --features ffmpeg_static

      - name: Package executable
        shell: pwsh
        run: |
          New-Item -ItemType Directory -Force dist
          Copy-Item target/release/grav1synth.exe dist/
          Compress-Archive -Path dist/grav1synth.exe -DestinationPath grav1synth-windows-x64.zip

      - name: Upload executable
        uses: actions/upload-artifact@v4
        with:
          name: grav1synth-windows-x64
          path: grav1synth-windows-x64.zip
          if-no-files-found: error
          retention-days: 7
